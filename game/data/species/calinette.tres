fragment = "(provisoire) Une tendresse qui n'ose pas tout à fait. Elle vient se blottir tout près, puis recule d'un bond, effrayée par sa propre audace. Il faut la cueillir au moment où elle s'avance."
details = PackedStringArray("(provisoire) Sa mousse garde la tiédeur d'une main posée sur l'épaule.", "(provisoire) Elle recule toujours d'un bond, mais jamais sans se retourner pour regarder.")
