---
import Logo from './Logo.astro';

const links = [
  { href: '#reve', label: 'Le rêve' },
  { href: '#chasseuse', label: 'La chasseuse' },
  { href: '#compagnon', label: 'Le compagnon' },
  { href: '#outils', label: 'Les outils' },
  { href: '#herbier', label: "L'herbier" },
  { href: '#partager', label: 'Partager', wide: true },
];
---

<header class="site-header wrap">
  <a class="site-header__brand" href="#top">
    <Logo variant="horizontal" size={44} label="ChronoFlore" />
  </a>
  <nav class="site-header__nav" aria-label="Sections">
    <ul>
      {links.map((l) => <li class:list={{ 'nav-wide': l.wide }}><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.25rem;
  }
  .site-header__brand {
    display: inline-flex;
    border-radius: 0.5rem;
  }
  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .site-header__nav a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--ink);
    text-decoration: underline 2px transparent;
    text-underline-offset: 0.35em;
    transition: text-decoration-color 160ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .site-header__nav a:hover {
      text-decoration-color: var(--accent);
    }
  }
  @media (max-width: 40rem) {
    .site-header {
      padding-block: 1rem 0.5rem;
    }
    .site-header__nav ul {
      gap: 0 1rem;
      font-size: 0.875rem;
    }
  }
  /* The hero's « Partager le rêve » covers it on the narrowest screens. */
  @media (max-width: 27.5rem) {
    .nav-wide {
      display: none;
    }
  }
</style>
