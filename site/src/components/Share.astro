---
import { SHARE_TEXT, SHARE_URL, shareLinks } from '../scripts/share';

const urls = shareLinks(SHARE_URL, SHARE_TEXT);
const links = [
  { label: 'Bluesky', href: urls.bluesky },
  { label: 'X', href: urls.x },
  { label: 'Facebook', href: urls.facebook },
];
---

<section id="partager" class="share wrap section" data-scene="partager" aria-labelledby="partager-title">
  <div class="share__card">
    <h2 id="partager-title">Fais circuler le rêve</h2>
    <p>Le jeu pousse encore. Un lien partagé, c'est une graine.</p>
    <div class="actions actions--center">
      <button type="button" class="btn btn--primary" data-copy-link>Copier le lien</button>
      {
        links.map((l) => (
          <a class="btn btn--soft" href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="share__manual" data-share-manual hidden>
      <label for="share-url">Copie ce lien :</label>
      <input id="share-url" type="text" readonly value={SHARE_URL} />
    </div>
  </div>
</section>

<style>
  .share {
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .share__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(1.25rem, 0.5rem + 3vw, 3rem);
    border-radius: 2rem;
    background: var(--surface);
    color: var(--on-surface);
    text-align: center;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-h2);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  p {
    margin: 0;
    max-width: 32rem;
    font-size: var(--step-lead);
    text-wrap: pretty;
  }
  .actions {
    padding-top: 0.75rem;
  }
  .share__manual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: min(100%, 26rem);
  }
  .share__manual[hidden] {
    display: none;
  }
  .share__manual input {
    width: 100%;
    min-height: 3rem;
    padding: 0 1rem;
    border: 2px solid var(--ring);
    border-radius: 999px;
    background: var(--surface);
    color: var(--on-surface);
    font: inherit;
    text-align: center;
  }
</style>
