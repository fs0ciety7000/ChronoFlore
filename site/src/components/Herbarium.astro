---
import PlateHeading from './PlateHeading.astro';
import { GENTLE, HOSTILE, THUMB_SIZE, altOf, hourLabel, plateNumber } from '../data/bestiary';

// Pastel card backgrounds, cycled in the palette's fixed plate tones.
const tints = ['--plate-rose', '--plate-mint', '--plate-lavender', '--plate-apricot'];
const tint = (i: number) => `var(${tints[i % tints.length]})`;

const groups = [
  { key: 'gentle', title: 'Les douces — à cueillir au filet', species: GENTLE, offset: 0 },
  { key: 'hostile', title: 'Les monstres plantes — à endormir avant de les cueillir', species: HOSTILE, offset: 2 },
];
---

<section id="herbier" class="herbarium wrap section" data-scene="herbier" aria-labelledby="herbier-title">
  <div class="herbarium__head">
    <PlateHeading plate="V" id="herbier-title">L'herbier des émotions</PlateHeading>
    <p class="herbarium__note">Textes provisoires — le bestiaire pousse avec le jeu</p>
  </div>
  {
    groups.map((g) => (
      <div class="herbarium__group" data-group={g.key}>
        <h3 class="herbarium__subtitle">{g.title}</h3>
        <ol class="herbarium__plates">
          {g.species.map((s, i) => (
            <li class="plate" data-specimen data-hostile={s.hostile ? '' : undefined} data-reveal style={`--plate: ${tint(i + g.offset)}`}>
              <div class="plate__head">
                <p class="plate__number">N° {plateNumber(s)}</p>
                {s.hostile && (
                  <p class="plate__hostile">
                    <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                      <path d="M6 1 L8 9 Q6 11 4 9 Z" fill="currentColor" />
                    </svg>
                    hostile
                  </p>
                )}
              </div>
              <div class="plate__thumb">
                <img src={s.image} alt={altOf(s)} width={THUMB_SIZE} height={THUMB_SIZE} loading="lazy" decoding="async" />
              </div>
              <h4>{s.name}</h4>
              <p class="plate__emotion">{s.emotion}</p>
              <p class="plate__tags">
                <span class="plate__rarity">{s.rarity}</span>
                <span class="plate__hour">{hourLabel(s)}</span>
              </p>
              <details class="plate__page">
                <summary>Lire la page</summary>
                <p>{s.fragment}</p>
              </details>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</section>

<style>
  .herbarium {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }
  .herbarium__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  /* A small pill, like .hero__kicker. */
  .herbarium__note {
    margin: 0;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--field);
    color: var(--on-field);
    font-size: 0.9375rem;
  }
  .herbarium__group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .herbarium__subtitle {
    margin: 0;
    font-family: var(--font-plate);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.625rem);
    line-height: 1.2;
  }
  .herbarium__plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Opening a page grows that card only. */
    align-items: start;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 56rem) {
    .herbarium__plates {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .plate {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: clamp(0.875rem, 0.7rem + 0.8vw, 1.25rem);
    border-radius: var(--radius-plate);
    background: var(--plate);
    color: var(--plate-ink);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--plate-ink) 12%, transparent);
  }
  .plate__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.5rem;
  }
  .plate__number {
    margin: 0;
    font-family: var(--font-plate);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--plate-ink-soft);
  }
  /* A small thorn: cute, never scary. */
  .plate__hostile {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0.125rem 0.5rem 0.125rem 0.375rem;
    border-radius: 999px;
    background: var(--plate-ink);
    color: #fffdf8;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .plate__thumb {
    display: grid;
    place-items: center;
    width: 78%;
    max-width: 9.5rem;
    aspect-ratio: 1;
    margin: 0.375rem auto 0.5rem;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 55%, #fffdf8 0 62%, color-mix(in srgb, #fffdf8 35%, transparent) 100%);
  }
  .plate__thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    transform-origin: 50% 90%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .plate:hover .plate__thumb img,
    .plate:focus-within .plate__thumb img {
      animation: plate-bounce 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
  @keyframes plate-bounce {
    0% { transform: translateY(0) scale(1, 1); }
    30% { transform: translateY(-8%) scale(0.96, 1.05); }
    60% { transform: translateY(0) scale(1.05, 0.95); }
    100% { transform: translateY(0) scale(1, 1); }
  }
  h4 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
  }
  .plate__emotion {
    margin: 0;
    font-family: var(--font-plate);
    font-style: italic;
    font-size: 1rem;
    color: var(--plate-ink-soft);
  }
  .plate__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
  }
  .plate__rarity {
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: #fffdf8;
    font-weight: 700;
  }
  .plate__page {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .plate__page summary {
    display: inline-block;
    padding: 0.25rem 0;
    cursor: pointer;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    border-radius: 0.25rem;
  }
  .plate__page summary:focus-visible {
    outline: 2px solid var(--plate-ink);
    outline-offset: 3px;
  }
  .plate__page p {
    margin: 0.375rem 0 0;
  }
</style>
