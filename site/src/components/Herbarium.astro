---
import PlateHeading from './PlateHeading.astro';

// Example species until game design fixes them (see the note in the heading).
const specimens = [
  {
    n: '001',
    latin: 'Nostalgia repens',
    name: 'Nostalgie rampante',
    line: "Pousse là où l'on revient trop souvent.",
    tint: 'var(--plate-rose)',
    drawing: 'repens',
  },
  {
    n: '002',
    latin: 'Gaudium volans',
    name: 'Joie-pissenlit',
    line: "S'envole au premier souffle.",
    tint: 'var(--plate-mint)',
    drawing: 'volans',
  },
  {
    n: '003',
    latin: 'Dubium scandens',
    name: 'Doute grimpant',
    line: "S'enroule autour de tout ce qu'il touche.",
    tint: 'var(--plate-lavender)',
    drawing: 'scandens',
  },
  {
    n: '004',
    latin: 'Memoria aestiva',
    name: "Souvenir d'été",
    line: "Ne fleurit qu'une fois par nuit.",
    tint: 'var(--plate-apricot)',
    drawing: 'aestiva',
  },
];

const leaf = (x: number, y: number, angle: number, size = 1) =>
  `<ellipse cx="${x}" cy="${y}" rx="${7 * size}" ry="${3.2 * size}" transform="rotate(${angle} ${x} ${y})" fill="var(--mint)" />`;

const drawings: Record<string, string> = {
  // A creeping stem that loops back on itself.
  repens: `
    <path d="M6 116 C26 118 32 96 50 98 C68 100 62 122 46 116 C32 110 50 88 72 94 C90 99 96 112 114 104" fill="none" stroke="var(--plate-ink)" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M22 116 l-2 9 M58 108 l1 8 M92 104 l3 8" stroke="var(--plate-ink)" stroke-width="1.2" stroke-linecap="round"/>
    ${leaf(16, 110, -30)}${leaf(38, 96, 20)}${leaf(80, 90, -25)}${leaf(104, 102, 30)}
    <g fill="var(--petal)" stroke="var(--plate-ink)" stroke-width="1.2"><circle cx="30" cy="102" r="4"/><circle cx="66" cy="92" r="4.5"/><circle cx="98" cy="96" r="3.5"/></g>`,
  // A dandelion clock, two seeds already gone.
  volans: `
    <path d="M60 136 C60 112 55 90 58 60" fill="none" stroke="var(--plate-ink)" stroke-width="1.6" stroke-linecap="round"/>
    ${leaf(50, 126, 35, 1.4)}${leaf(70, 122, -40, 1.3)}
    <g stroke="var(--plate-ink)" stroke-width="1.1" stroke-linecap="round">
      ${Array.from({ length: 14 }, (_, i) => {
        const a = (i / 14) * Math.PI * 2;
        const x = (58 + Math.cos(a) * 20).toFixed(1);
        const y = (44 + Math.sin(a) * 20).toFixed(1);
        return `<path d="M58 44 L${x} ${y}"/>`;
      }).join('')}
    </g>
    <circle cx="58" cy="44" r="4" fill="var(--plate-ink)"/>
    <g fill="var(--plate-ink)"><circle cx="93.6" cy="33.4" r="1.6"/><circle cx="103.4" cy="57.4" r="1.6"/></g>
    <g fill="none" stroke="var(--plate-ink)" stroke-width="1.1" stroke-linecap="round">
      <path d="M94 32 L97 22 M97 22 l-4 -4 M97 22 l1 -6 M97 22 l5 -3"/>
      <path d="M104 56 L108 47 M108 47 l-3 -5 M108 47 l2 -6 M108 47 l6 -2"/>
    </g>`,
  // A tendril winding up its stake.
  scandens: `
    <path d="M60 136 L60 12" stroke="var(--plate-ink-soft)" stroke-width="2" stroke-linecap="round"/>
    <path d="M60 134 C82 126 82 114 60 106 C38 98 38 88 60 80 C82 72 82 62 60 54 C40 46 42 34 58 30 C70 27 72 18 62 14" fill="none" stroke="var(--fern)" stroke-width="1.8" stroke-linecap="round"/>
    ${leaf(78, 118, -20)}${leaf(42, 96, 25)}${leaf(78, 66, -30)}${leaf(46, 42, 20)}
    <circle cx="62" cy="14" r="3" fill="var(--lavender)" stroke="var(--plate-ink)" stroke-width="1.2"/>`,
  // A single summer bloom.
  aestiva: `
    <path d="M60 136 C63 116 57 96 60 72" fill="none" stroke="var(--plate-ink)" stroke-width="1.6" stroke-linecap="round"/>
    ${leaf(50, 112, 30, 1.5)}${leaf(70, 98, -30, 1.4)}
    <g fill="var(--sun)" stroke="var(--plate-ink)" stroke-width="1.2">
      ${[0, 72, 144, 216, 288].map((a) => `<ellipse cx="60" cy="38" rx="8" ry="14" transform="rotate(${a} 60 52)"/>`).join('')}
    </g>
    <circle cx="60" cy="52" r="6" fill="var(--petal)" stroke="var(--plate-ink)" stroke-width="1.2"/>`,
};
---

<section id="herbier" class="herbarium wrap section" data-scene="herbier" aria-labelledby="herbier-title">
  <div class="herbarium__head">
    <PlateHeading plate="IV" id="herbier-title">L'herbier des émotions</PlateHeading>
    <p class="herbarium__note veil">[Espèces d'exemple — à définir avec le game design]</p>
  </div>
  <ol class="herbarium__plates">
    {
      specimens.map((s) => (
        <li class="plate" data-specimen style={`--plate: ${s.tint}`}>
          <p class="plate__number">N° {s.n}</p>
          <svg class="plate__drawing" viewBox="0 0 120 140" aria-hidden="true">
            <Fragment set:html={drawings[s.drawing]} />
          </svg>
          <p class="plate__latin" lang="la">{s.latin}</p>
          <h3>{s.name}</h3>
          <p class="plate__line">{s.line}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .herbarium {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }
  .herbarium__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  .herbarium__note {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .herbarium__plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 56rem) {
    .herbarium__plates {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Rows are shared across plates (subgrid) so names line up whatever wraps. */
  .plate {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0.25rem;
    padding: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    border-radius: var(--radius-plate);
    background: var(--plate);
    color: var(--plate-ink);
  }
  .plate__number {
    margin: 0;
    font-family: var(--font-plate);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--plate-ink-soft);
  }
  .plate__drawing {
    display: block;
    width: 62%;
    max-width: 9rem;
    aspect-ratio: 120 / 140;
    margin: 0.5rem auto 1rem;
    align-self: center;
  }
  .plate__latin {
    margin: 0;
    font-family: var(--font-plate);
    font-style: italic;
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.15;
    align-self: end;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
  }
  .plate__line {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
</style>
