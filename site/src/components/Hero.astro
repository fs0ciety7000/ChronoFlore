---
// Opening. #diorama starts as the poster; Task 7 swaps in the live 3D scene
// (data-state="live") inside the same box, so keep its aspect ratio.
---

<section id="top" class="hero wrap" data-scene="opening" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="hero__kicker">Jeu d'action-arcade · en développement</p>
    <h1 id="hero-title">Huit heures de sommeil. Toute une flore à capturer.</h1>
    <p class="hero__lead">
      Lucide dans son rêve, elle devient botaniste-chasseuse. Chaque plante est une émotion, un
      souvenir, une pensée. Elle a jusqu'au réveil pour en sauver le plus possible.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="#partager" data-share-primary>Partager le rêve</a>
      <a class="btn btn--quiet" href="#reve">Découvrir l'histoire</a>
    </div>
  </div>
  <div id="diorama" class="hero__diorama" data-state="poster">
    <img
      src="/poster.webp"
      alt=""
      width="1040"
      height="880"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2rem 3rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .hero__kicker {
    margin: 0;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--field);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-h1);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hero__lead {
    margin: 0;
    max-width: 33rem;
    font-size: var(--step-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .actions {
    padding-top: 0.5rem;
  }
  .hero__diorama {
    position: relative;
    width: 100%;
    max-width: 42rem;
    justify-self: center;
    aspect-ratio: 520 / 440;
  }
  .hero__diorama img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
