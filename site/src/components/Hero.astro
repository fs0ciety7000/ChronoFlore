---
// Opening. #diorama is a full-bleed stage behind the page: it starts as the
// poster (absolute, at the top of the page) and, when the live 3D scene is
// ready (src/scripts/diorama/loader.ts), becomes a fixed backdrop on desktop
// (data-state="live"): past the hero the island glides into a right-hand lane
// that the sections keep free (--lane in global.css). On small screens the
// stage scrolls away with the hero. The hero copy is kept clear of the island
// by geometry (max-width below vs focusRect in diorama/framing.ts).
---

<section id="top" class="hero wrap" data-scene="opening" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="hero__kicker">Jeu d'action-arcade · en développement</p>
    <h1 id="hero-title">Huit heures de sommeil. Toute une flore à capturer.</h1>
    <p class="hero__lead">
      Lucide dans son rêve, elle devient botaniste-chasseuse. Chaque plante est une émotion, un
      souvenir, une pensée. Elle a jusqu'au réveil pour en sauver le plus possible.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="#partager" data-share-primary>Partager le rêve</a>
      <a class="btn btn--quiet" href="#reve">Découvrir l'histoire</a>
      <a class="btn btn--soft" href="/jouer/">Jouer au prototype</a>
    </div>
  </div>
  <div id="diorama" class="stage" data-state="poster">
    <img
      src="/poster.webp"
      alt=""
      width="1000"
      height="1000"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    /* Island placement, shared by the poster and scene.ts (focusRect). */
    --focus-size: min(98vw, 52lvh);
    --focus-x: 50vw;
    --focus-y: 30lvh;
    display: grid;
    align-content: center;
    min-height: calc(100svh - 5.5rem);
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  @media (min-width: 56rem) {
    .hero {
      --focus-size: min(50vw, 95lvh);
      --focus-x: 72vw;
      --focus-y: 54lvh;
    }
  }
  /* Small screens: the island floats above the copy. */
  @media (max-width: 55.99rem) {
    .hero {
      align-content: end;
      padding-top: calc(var(--focus-y) + var(--focus-size) * 0.32 - 4.5rem);
      min-height: 0;
    }
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 36rem;
  }
  @media (min-width: 56rem) {
    .hero__text {
      /* Ends left of the island (focusRect keeps it right of 46vw + 24px). */
      max-width: min(36rem, calc(46vw - var(--gutter)));
    }
  }
  .hero__kicker {
    margin: 0;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--field);
    color: var(--on-field);
    font-size: 0.875rem;
    font-weight: 700;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-h1);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hero__lead {
    margin: 0;
    max-width: 33rem;
    font-size: var(--step-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .actions {
    padding-top: 0.5rem;
  }

  /*
   * The stage. --focus-* place the island; scene.ts (focusRect) frames the 3D
   * camera on the same point so the poster and the live scene line up.
   * No ancestor of #diorama is positioned, so in the poster state it is laid
   * out against the initial containing block: the first screen of the page.
   */
  .stage {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100lvh;
    overflow: hidden;
    pointer-events: none;
  }
  @media (min-width: 56rem) {
    .stage[data-state='live'] {
      position: fixed;
    }
  }
  .stage img {
    position: absolute;
    left: calc(var(--focus-x) - var(--focus-size) / 2);
    top: calc(var(--focus-y) - var(--focus-size) / 2);
    width: var(--focus-size);
    height: var(--focus-size);
    object-fit: contain;
    transition: opacity 600ms ease;
  }
  .stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .stage[data-state='live'] img {
    opacity: 0;
  }
  .stage[data-state='live'] :global(canvas) {
    opacity: 1;
  }
</style>
