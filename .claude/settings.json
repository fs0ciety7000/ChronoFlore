{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Skill",

      "Bash(git *)",
      "Bash(gh *)",

      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(pnpm wrangler *)",

      "Bash(npx skills *)",
      "Bash(npx skills@latest *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(deno *)",

      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(go *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(uv *)",

      "Bash(godot *)",
      "Bash(shopify *)",
      "Bash(docker *)",
      "Bash(make *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(curl *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git push * --delete *)",
      "Bash(git push origin :*)",

      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh repo edit * --visibility *)",

      "Bash(wrangler delete *)",
      "Bash(wrangler * delete *)",
      "Bash(wrangler secret *)",
      "Bash(wrangler login*)",
      "Bash(npx wrangler delete *)",
      "Bash(npx wrangler * delete *)",
      "Bash(npx wrangler secret *)",

      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(docker system prune*)",
      "Bash(npm publish*)",
      "Bash(cargo publish*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.wrangler/**)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  }
}
